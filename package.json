{
  "name": "danmu.js",
  "version": "1.2.1",
  "description": "HTML5 danmu (danmaku) plugin for any DOM element",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": "./browser/index.mjs"
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "files": [
    "dist",
    "browser"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "dev": "rslib build --watch",
    "build": "rslib build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "serve": "serve ./",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "bench:browser": "pnpm run build && node scripts/browser-bench.mjs",
    "test:browser": "pnpm run build && node scripts/browser-integration.mjs",
    "release": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm publish",
    "release:rc": "pnpm run release -- --tag rc"
  },
  "keywords": [
    "danmu",
    "danmaku",
    "弹幕",
    "bullet screen",
    "barrage",
    "live commenting",
    "HTML5"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@rslib/core": "^1.0.6",
    "css-loader": "^7.1.5",
    "playwright": "^1.65.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "serve": "^14.2.7",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytedance/danmu.js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "author": "zhangxin.frontend@bytedance.com",
  "license": "MIT"
}
