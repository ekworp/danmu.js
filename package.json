{
  "name": "@ekworp/danmu.js",
  "version": "1.4.0",
  "type": "module",
  "description": "HTML5 danmu (danmaku) plugin for any DOM element",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./browser": "./browser/index.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.scss"
  ],
  "files": [
    "dist",
    "browser"
  ],
  "scripts": {
    "prepare": "pnpm run build",
    "dev": "tsdown --watch",
    "build": "tsdown && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "docs:dev": "vitepress dev docs",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:build": "pnpm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/bench.mjs",
    "bench:browser": "pnpm run build && node scripts/browser-bench.mjs",
    "test:browser": "pnpm run build && node scripts/browser-integration.mjs",
    "release": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm publish",
    "release:rc": "pnpm run release -- --tag rc"
  },
  "keywords": [
    "danmu",
    "danmaku",
    "弹幕",
    "bullet screen",
    "barrage",
    "live commenting",
    "HTML5"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tsdown/css": "^0.23.7",
    "playwright": "^1.65.0",
    "sass": "^1.108.2",
    "serve": "^14.2.8",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekworp/danmu.js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "author": "ekworp",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
